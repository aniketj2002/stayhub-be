# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS builder

WORKDIR /src
RUN apk add --no-cache ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/stayhub-worker ./cmd/worker

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S stayhub && adduser -S stayhub -G stayhub

WORKDIR /app

COPY --from=builder /out/stayhub-worker /app/stayhub-worker

RUN mkdir -p /app/data/media/uploads && \
    chown -R stayhub:stayhub /app

USER stayhub

ENTRYPOINT ["/app/stayhub-worker"]
