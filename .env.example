# Server
APP_ENV=development
HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://stayhub:stayhub_dev_pwd@localhost:5432/stayhub?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth / JWT
JWT_SECRET=stayhub-local-dev-secret-change-in-prod
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

# S3 / MinIO Media Storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=/api/v1/media/file
S3_REGION=eu-west-1
S3_BUCKET=stayhub-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true

# Platform Money Defaults (Basis Points: 1400 = 14%, 300 = 3%)
DEFAULT_CURRENCY=EUR
GUEST_FEE_BPS=1400
HOST_FEE_BPS=300
REQUEST_EXPIRY_HOURS=24
PAYOUT_RELEASE_AFTER_CHECKIN_HOURS=24

# AWS / EventBridge Scheduler & SQS Payout Queue & SES Email
AWS_REGION=eu-west-1
AWS_ENDPOINT_URL=http://localhost:4566
SES_SENDER_EMAIL=aniketjindal2002@gmail.com
APP_BASE_URL=http://localhost:5173
EVENTBRIDGE_ROLE_ARN=arn:aws:iam::000000000000:role/stayhub-scheduler-execution-role
PAYOUT_QUEUE_URL=http://sqs.eu-west-1.localhost.localstack.cloud:4566/000000000000/stayhub-payout-queue
PAYOUT_QUEUE_ARN=arn:aws:sqs:eu-west-1:000000000000:stayhub-payout-queue

# Version Mode ('v1' auto-approves listings passing automated checks; 'v2' queues for admin review)
STAYHUB_VERSION_MODE=v1
